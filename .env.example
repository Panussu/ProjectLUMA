# ==============================================================================
# ProjectLUMA - Global & Production Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env or use as a reference for backend/.env and ai-engine/.env

# ------------------------------------------------------------------------------
# 1. Global / Frontend Settings
# ------------------------------------------------------------------------------
# Port exposed by Nginx reverse proxy
FRONTEND_PORT=80

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://192.168.1.10

# ------------------------------------------------------------------------------
# 2. Backend Service Settings (Flask API)
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0
WEB_THREADS=8
LOG_LEVEL=INFO

# Application Security Keys (MUST be changed to long random strings in production!)
# Example generator: openssl rand -hex 32
SECRET_KEY=change-this-to-a-secure-random-secret-key-32chars
JWT_SECRET_KEY=change-this-to-a-different-secure-jwt-secret-key-32chars
JWT_HOURS=8

# Database Connection (Default: SQLite at /data/luma.db)
# PostgreSQL example: postgresql+psycopg://luma:securepassword@db-host:5432/lumadb
DATABASE_URL=sqlite:////data/luma.db
DATA_ROOT=/data
MEDIA_ROOT=/media

# AI Service Connection (Points to AI Engine FastAPI)
AI_SERVICE_URL=http://ai-engine:8000
AI_SERVICE_TOKEN=change-this-to-a-secure-shared-service-token-32chars
AI_CONNECT_TIMEOUT=5
AI_READ_TIMEOUT=180

# Upload & Media Limits
MAX_CONTENT_LENGTH=16777216
MEDIA_TOKEN_MAX_AGE=3600

# ------------------------------------------------------------------------------
# 3. AI Engine Service Settings (FastAPI)
# ------------------------------------------------------------------------------
FASTAPI_DEBUG=0

# AI Provider Mode: 'forge' (Real SD WebUI) or 'development-procedural' (Mock / No GPU)
AI_PROVIDER=development-procedural

# Stable Diffusion WebUI / Forge Address (Default local port: 7860)
FORGE_URL=http://127.0.0.1:7860
FORGE_USERNAME=
FORGE_PASSWORD=
FORGE_CHECKPOINT=
FORGE_SAMPLER=Euler
FORGE_SCHEDULER=
FORGE_CFG_SCALE=7
FORGE_EDIT_STEPS=20
FORGE_CONNECT_TIMEOUT=5
FORGE_READ_TIMEOUT=300
