# PC 3: Flask API and SQLite on the classroom VLAN.
# 192.168.1.20 is the proposed PC 3 address; confirm it with ipconfig.
# เลือกโหมดพัฒนาหรือ VLAN เพื่อกำหนดการตรวจค่าตอนเริ่มระบบ
DEPLOYMENT_MODE=vlan
# ที่อยู่รับการเชื่อมต่อและพอร์ตของบริการ ใช้ IP จริงเมื่อเรียกจากเครื่องอื่น
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0
WEB_THREADS=8
# ระดับข้อความที่เขียนลงบันทึกการทำงาน
LOG_LEVEL=INFO

# กุญแจลงลายเซ็นของ Backend และ JWT ต้องตั้งค่าสุ่มคนละค่า

SECRET_KEY=replace-with-a-long-random-value
JWT_SECRET_KEY=replace-with-a-different-long-random-value
# อายุ JWT หน่วยชั่วโมงก่อนต้องเข้าสู่ระบบใหม่
JWT_HOURS=8

# Leave DATABASE_URL unset to create backend/data/luma.db on PC 3.

# PC 1 runs the FastAPI wrapper at the proposed address 192.168.1.30.
# ปลายทาง FastAPI ที่ Flask เรียกและเวลารอหน่วยวินาที
AI_SERVICE_URL=http://192.168.1.30:8000
# โทเคนร่วมต้องตรงกันบน PC 1 และ PC 3 และต้องเปลี่ยนค่าตัวอย่าง
AI_SERVICE_TOKEN=replace-with-one-shared-long-random-service-token
AI_CONNECT_TIMEOUT=5
AI_READ_TIMEOUT=180
# เปิดการกู้คิวที่บันทึกไว้เมื่อ Backend เริ่มใหม่
RECOVER_JOBS_ON_STARTUP=1

# ขนาดคำขอสูงสุดเป็นไบต์ เช่น 16777216 เท่ากับ 16 MiB

MAX_CONTENT_LENGTH=16777216
# จำนวนพิกเซลสูงสุดที่ยอมรับจากภาพผลลัพธ์ AI
MAX_OUTPUT_PIXELS=4194304
# อายุลิงก์ภาพที่มีลายเซ็น หน่วยวินาที
MEDIA_TOKEN_MAX_AGE=3600
# จำนวนวันเก็บงานก่อนเข้าเงื่อนไขเครื่องมือล้างข้อมูล
MEDIA_RETENTION_DAYS=30

# The browser enters through Nginx on PC 2.
# origin ของ Frontend ที่อนุญาตให้อ่านคำตอบข้าม origin
CORS_ORIGINS=http://192.168.1.10
