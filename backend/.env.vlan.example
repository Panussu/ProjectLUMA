# PC 3: Flask API and SQLite on the classroom VLAN.
# 192.168.1.20 is the proposed PC 3 address; confirm it with ipconfig.
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0
WEB_THREADS=8
LOG_LEVEL=INFO

SECRET_KEY=replace-with-a-long-random-value
JWT_SECRET_KEY=replace-with-a-different-long-random-value
JWT_HOURS=8

# Leave DATABASE_URL unset to create backend/data/luma.db on PC 3.

# PC 1 runs the FastAPI wrapper at the proposed address 192.168.1.30.
AI_SERVICE_URL=http://192.168.1.30:8000
AI_SERVICE_TOKEN=replace-with-the-same-long-random-value-as-the-ai-service
AI_CONNECT_TIMEOUT=5
AI_READ_TIMEOUT=180

MAX_CONTENT_LENGTH=16777216
MEDIA_TOKEN_MAX_AGE=3600

# The browser enters through Nginx on PC 2.
CORS_ORIGINS=http://192.168.1.10
