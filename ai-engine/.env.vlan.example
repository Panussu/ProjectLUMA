# PC 1: FastAPI wrapper and WebUI Forge on the classroom VLAN.
# 192.168.1.30 is the proposed PC 1 address; confirm it with ipconfig.
HOST=0.0.0.0
PORT=8000
FASTAPI_DEBUG=0
LOG_LEVEL=INFO
MAX_CONTENT_LENGTH=16777216

# Use the exact same value in backend/.env on PC 3.
AI_SERVICE_TOKEN=replace-with-one-shared-long-random-service-token
AI_PROVIDER=forge

# Forge stays private on PC 1. Launch it with --api --port 7860.
FORGE_URL=http://127.0.0.1:7860
FORGE_USERNAME=
FORGE_PASSWORD=
FORGE_CHECKPOINT=
FORGE_SAMPLER=Euler
FORGE_SCHEDULER=
FORGE_CFG_SCALE=7
FORGE_EDIT_STEPS=20
FORGE_CONNECT_TIMEOUT=5
FORGE_READ_TIMEOUT=300
